{
  "expo": {
    "name": "services-app",
    "slug": "services-app",
    "scheme": "servicesapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.servicesapp.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to find professionals near you and to show the one on the way to your door.",
        "NSCameraUsageDescription": "Used to scan the QR code the professional shows at your door, so you can confirm who has arrived."
      }
    },
    "android": {
      "package": "com.servicesapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B4B8F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to find professionals near you and to show the one on the way to your door."
        }
      ],
      "@sentry/react-native",
      "expo-web-browser"
    ]
  }
}
