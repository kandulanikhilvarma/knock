# Copy to .env and fill. EXPO_PUBLIC_ vars are exposed to the client bundle.
# The anon key is client-safe by design; RLS protects data. NEVER put service_role here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry DSN — public ingest key, safe in the bundle. Empty = crash reporting off.
EXPO_PUBLIC_SENTRY_DSN=
